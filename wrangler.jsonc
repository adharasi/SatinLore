{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satinlore-private-app",
  "account_id": "7ce3ade1bea6bcbe457c8d632756822e",
  "main": "deploy/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.satinlore.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/private-app",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://app.satinlore.com",
    "PRIVATE_APP_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "satinlore.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "FOUNDER_EMAIL": "team@satinlore.com"
  }
}
