# Reference only: run.py does not automatically load .env files.
# Set process environment variables before starting the server or creating invites.
SATINLORE_ENV=development
SATINLORE_DEVICE_MODE=simulator
SATINLORE_APP_ORIGIN=http://127.0.0.1:8000
# Relative paths resolve from your current working directory; use an absolute path if needed.
SATINLORE_DATABASE_PATH=data/satinlore.sqlite3
SATINLORE_SESSION_TTL_SECONDS=3600

# Only required when explicitly choosing SATINLORE_DEVICE_MODE=lovense.
# Never commit real values or put them in browser code, screenshots or chat.
LOVENSE_DEVELOPER_TOKEN=
LOVENSE_PLATFORM_NAME=
