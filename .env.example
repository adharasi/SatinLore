# Reference only: run.py does not automatically load .env files.
# The app reads these from process environment; only a local simulator is supported.
SATINLORE_ENV=development
SATINLORE_DEVICE_MODE=simulator

# Reserved for the future server-side integration; currently unused.
# Never put real secrets in a committed file, browser bundle, or chat message.
LOVENSE_DEVELOPER_TOKEN=
LOVENSE_PLATFORM_NAME=
