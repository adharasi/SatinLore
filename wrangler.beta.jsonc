{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satinlore-private-beta",
  "account_id": "7ce3ade1bea6bcbe457c8d632756822e",
  "main": "deploy/cloudflare/beta-preview.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    { "pattern": "https://app.satinlore.com/beta", "zone_name": "satinlore.com" },
    { "pattern": "https://app.satinlore.com/beta/*", "zone_name": "satinlore.com" }
  ],
  "assets": {
    "directory": "./dist/private-app",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "PRIVATE_FEEDBACK", "class_name": "PrivateFeedback" },
      { "name": "READER_ACCOUNTS", "class_name": "ReaderAccount" },
      { "name": "SCENE_ANALYSIS_BUDGET", "class_name": "SceneAnalysisBudget" },
      { "name": "PUBLIC_READER_AUTH", "class_name": "PublicReaderAuth" },
      { "name": "COMMERCE", "class_name": "SatinLoreCommerce" },
      { "name": "LAUNCH_USAGE", "class_name": "LaunchUsage" }
    ]
  },
  "migrations": [
    { "tag": "beta-preview-v1", "new_sqlite_classes": ["PrivateFeedback", "ReaderAccount", "SceneAnalysisBudget", "PublicReaderAuth", "SatinLoreCommerce", "LaunchUsage"] }
  ],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://app.satinlore.com",
    "LAUNCH_PAYMENT_PROVIDER": "stripe",
    "STRIPE_MODE": "test",
    "LAUNCH_AI_COST_METERING_ENABLED": "true"
  }
}
