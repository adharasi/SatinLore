{
  "name": "satinlore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build:worker": "node scripts/build-private-app.mjs",
    "deploy:worker": "npm run build:worker && wrangler deploy --config wrangler.jsonc",
    "test:worker": "node --test tests/private-worker.test.mjs"
  },
  "devDependencies": {
    "miniflare": "4.20260515.0",
    "playwright": "1.62.1",
    "wrangler": "4.92.0",
    "esbuild": "0.27.3"
  },
  "dependencies": {
    "jose": "6.1.3"
  }
}
